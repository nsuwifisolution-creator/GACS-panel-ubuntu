[Unit]
Description=GenieACS NBI service
After=network.target mongod.service

[Service]
Type=simple
EnvironmentFile=/opt/genieacs/genieacs.env
ExecStart=/usr/bin/genieacs-nbi
Restart=always
RestartSec=5
User=genieacs
Group=genieacs
WorkingDirectory=/opt/genieacs

[Install]
WantedBy=multi-user.target
