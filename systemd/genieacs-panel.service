[Unit]
Description=GenieACS Panel Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/genieacs-panel/backend
ExecStart=/usr/bin/node src/app.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=5000
User=root
Group=root

[Install]
WantedBy=multi-user.target
